# 資格情報。3役のトークンは箱の /etc/loop/<役>.env に置き、リポジトリには置かない。
# 公開リポジトリに一度でも入れば自動収集されるので、写しを置く事故も塞いでおく。
.env
.env.*
!.env.example

# SSH 鍵。provision/15-authkeys.sh は鍵ペアをリポジトリ外から受け取る設計だが、
# 生成した鍵をここに置いてしまう事故を防ぐため、公開鍵ごと弾く。
*.pem
*.key
id_rsa*
id_ed25519*
*_ed25519
*_ed25519.pub
loop-dev
loop-dev.pub
loop-runner
loop-runner.pub

# `wsl --export` snapshots. Several GB; keep them outside the repo.
*.tar
*.vhdx

__pycache__/
*.pyc

# 手元だけで使う要件。対象のリポジトリの非公開の事情を書くことがあるので、コミットしない。
# requirements/ の直下にあるものは、走行の記録として README と PLANS.md が参照する。
requirements/local/

# Host dashboard runtime state and machine-local launcher configuration.
host/dashboard/.state/
host/dashboard/config.json

# プロンプト
/CLAUDE.md