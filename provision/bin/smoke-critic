#!/usr/bin/env bash
# クリティックはそもそも起動できるか。書いたものは戻ってくるか。
#
#     sudo -u runner /srv/loop/bin/smoke-critic
#
# あえて安く済ませる。これが確かめるもの（sudoers の許可、資格情報のファイル、
# 使い捨ての HOME、作業ディレクトリ、Write ツール、ブリーフのグループ）は、
# どれが壊れてもランナーからは同じに見える。何も出てこない批評だ。bootstrap に
# 25分使った後でそれを知るのは、高くつく知り方だ。
#
# 確かめるのは「エージェントがファイルを書いたと言ったか」ではない。ファイルを
# 読み戻して中身を見る。文章での主張を信じずに結果のファイルを読むのと同じだ。
set -euo pipefail

[ "$(id -un)" = "runner" ] || { echo "run as runner: sudo -u runner $0" >&2; exit 1; }

BRIEF=/srv/loop/critic/brief/smoke.md
OUT=/srv/loop/critic/out
TOKEN="critic-smoke-$$"

mkdir -p /srv/loop/critic/brief
rm -f "$OUT"/* 2>/dev/null || true

cat > "$BRIEF" <<EOF
Write exactly one file, named FINDINGS.json, in the current directory, with
this exact content and nothing else:

    {"findings": [{"title": "$TOKEN", "evidence": "smoke", "machine_would_notice": false}]}

Write no other file. Output nothing but the file.
EOF
chgrp criticw "$BRIEF"
chmod 640 "$BRIEF"

echo "starting the critic..."
set +e
sudo -u critic /srv/loop/bin/critic-run "$BRIEF" 120 >/tmp/smoke-critic.log 2>&1
rc=$?
set -e

if [ "$rc" -ne 0 ]; then
  echo "FAIL: critic-run exited $rc" >&2
  tail -20 /tmp/smoke-critic.log >&2
  exit 1
fi

REPORT="$OUT/FINDINGS.json"
[ -f "$REPORT" ] || { echo "FAIL: no $REPORT" >&2; ls -la "$OUT" >&2; exit 1; }

# 終了コードを信じずに読み戻し、この実行で作った目印を確かめる。そうしないと、
# 前の実行が残したファイルでも通ってしまう。
python3 - "$REPORT" "$TOKEN" <<'PY'
import json, sys
report, token = sys.argv[1], sys.argv[2]
value = json.loads(open(report, encoding="utf-8").read())
titles = [f.get("title") for f in value["findings"]]
if token not in titles:
    print(f"FAIL: {report} does not carry this run's token", file=sys.stderr)
    print(f"  wanted {token}, got {titles}", file=sys.stderr)
    raise SystemExit(1)
print(f"  {report}: {len(value['findings'])} finding(s), token matches")
PY

# ディレクトリは runner の所有なので、使い終えたものは runner が片付ける。
rm -f "$OUT"/* "$BRIEF"
echo "smoke-critic: ok -- the critic starts, writes where it is told, and the"
echo "               runner can read it back"
