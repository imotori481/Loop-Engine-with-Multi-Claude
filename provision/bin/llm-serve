#!/usr/bin/env bash
# ローカルの推論サーバを、uid `llm` で動かす。
#
#     sudo -u llm /srv/loop/bin/llm-serve
#
# solver でも runner でも planner でもない、専用のアカウント。solver はループ
# バックで届くが、再起動も、重みを読むことも、起動のしかたを変えることもできない。
# ここのほかの場所と同じ理屈で、柵は uid であり、誰が何を呼ぶかの約束ではない。
set -euo pipefail

WEIGHTS="${LOOP_LLM_WEIGHTS:-/srv/loop/models/model.gguf}"
PORT="${LOOP_LLM_PORT:-8080}"
# 16384。選んだ値ではなく測った値だ。2回測った。1回目は、ステップに何が要るかの
# 見積もりを誤っていた。
#
# この箱の GPU は RTX 2060 で 6144 MiB、その大半を重み（IQ4_XS、4.81 GB）が使う。
# 8192 は、ブリーフと書いてよいファイルで 2〜3k トークンという見積もりで選んだ。
# run 8 の S1 は 5,997 だった。うち2千は実装が満たすべき凍結済みのテスト12件、
# さらに千5百はどのステップも受け取る CONTEXT.md だ。見積もりは半分に過ぎなかった。
#
# 倍にして増えたのは 158 MiB（実測、6,144 のうち 5,276 -> 5,434）。KV キャッシュを
# 量子化している（下の --cache-type-k/v q8_0）ので安く済む。それが無ければ
# 収まらなかった。
CTX="${LOOP_LLM_CTX:-16384}"
# GPU があれば全層を載せる。llama-server は収まらない分を黙って CPU に回す。
# 振る舞いとしては正しいが、遅さで驚かされる。smoke-local が毎秒のトークン数を
# 報告するので、回されたことが見える。
NGL="${LOOP_LLM_NGL:-99}"

[ -r "$WEIGHTS" ] || {
  echo "llm-serve: 重みを読めない: $WEIGHTS" >&2
  echo "  直し方: そこに .gguf を置く（root 所有、0444）か、LOOP_LLM_WEIGHTS で場所を渡す。" >&2
  exit 2
}
command -v llama-server >/dev/null || {
  echo "llm-serve: llama-server が PATH に無い。LOCAL_SOLVER.md の手順1を参照。" >&2
  exit 2
}

# --host 127.0.0.1   外に出るインターフェイスには決して出さない。この VM の外の
#                    何かが、ソルバーのモデルサーバに届く理由は無い。
# --jinja            必須。無いと llama.cpp はモデル自身のチャットテンプレートを
#                    走らせず、思考を切る手段である `chat_template_kwargs` が黙って
#                    無視される。考えるのを止められない思考モデルは、このフラグが
#                    防ぐための失敗で、しかも静かに起きる。
# --alias local      solver-local が "model" として送る名前。
exec llama-server \
  --model "$WEIGHTS" \
  --alias local \
  --host 127.0.0.1 \
  --port "$PORT" \
  --ctx-size "$CTX" \
  --n-gpu-layers "$NGL" \
  --jinja \
  --cache-type-k q8_0 \
  --cache-type-v q8_0

# --log-file は付けない。/srv/loop/models は 2750 root:llm なので、`llm` は重みを
# 読めるが、その隣には書けない。それは正しく、ログは別の場所に行く必要がある。
# systemd の下ではジャーナル（journalctl -u loop-llm）になる。
