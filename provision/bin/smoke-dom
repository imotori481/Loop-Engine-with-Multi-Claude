#!/usr/bin/env bash
# 画面の無い機械は、本当に死んだユーザーインターフェイスを捕まえられるか。
#
#     sudo -u runner /srv/loop/bin/smoke-dom
#
# Node の道筋全体を支える主張は、DOM は画面なしで動かせるので、「プレイヤーが
# 押せるものが何も無い」が人間しか気づかないものではなく赤いテストになる、と
# いうことだ。これはその主張を両方向で確かめる。そこが肝心だ。何でも通す関門は、
# ある日そうでなくなるまで、働いている関門と見分けがつかない。
#
#   動く UI        -> 3 件通る
#   run 7 の UI    -> 2 件落ちる。1つは "expected 0 to be greater than 0"
#
# 2つ目の形は作り話ではない。run 7 が出荷したものだ。最初の1フレームから全部の
# ボタンが無効な窓が、緑のステップ10と通ったテスト42をすり抜けた。ランナーに
# 見えるものの中に、画面について意見を持つものが無かったからだ。
set -euo pipefail

TOOLS=/srv/loop/node
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

VITEST="$TOOLS/node_modules/.bin/vitest"
[ -x "$VITEST" ] || { echo "smoke-dom: no toolchain at $TOOLS; run 35-node.sh" >&2; exit 2; }

mkdir -p "$WORK/tests"
ln -s "$TOOLS/node_modules" "$WORK/node_modules"

cat > "$WORK/vitest.config.mjs" <<'EOF'
export default { test: { environment: "happy-dom", include: ["tests/**/*.test.mjs"] } };
EOF

# 検査する対象を2つの版で用意する。違うのは `mount` だけ。
cat > "$WORK/alive.mjs" <<'EOF'
export function mount(root, state) {
  const total = document.createElement("p");
  total.id = "total";
  const gather = document.createElement("button");
  gather.id = "gather";
  gather.textContent = "Gather";
  const render = () => { total.textContent = String(state.resource); };
  gather.addEventListener("click", () => { state.resource += 1; render(); });
  root.append(total, gather);
  render();
  return root;
}
EOF

cat > "$WORK/dead.mjs" <<'EOF'
// run 7 の形: 窓は開くが、中のものは何ひとつ押せない。
export function mount(root, state) {
  const total = document.createElement("p");
  total.id = "total";
  total.textContent = String(state.resource);
  const buy = document.createElement("button");
  buy.id = "buy";
  buy.textContent = "Buy cursor (15)";
  buy.disabled = state.resource < 15;      // 0 < 15 は、いまも、この先もずっと成り立つ
  root.append(total, buy);
  return root;
}
EOF

cat > "$WORK/tests/ui.test.mjs" <<'EOF'
import { describe, expect, it } from "vitest";
import { mount } from "../subject.mjs";

describe("the screen", () => {
  it("shows the starting state", () => {
    const root = mount(document.createElement("div"), { resource: 0 });
    expect(root.querySelector("#total").textContent).toBe("0");
  });

  it("has at least one control the player can press", () => {
    const root = mount(document.createElement("div"), { resource: 0 });
    const pressable = [...root.querySelectorAll("button")].filter(b => !b.disabled);
    expect(pressable.length).toBeGreaterThan(0);
  });

  it("increases the resource when that control is pressed", () => {
    const root = mount(document.createElement("div"), { resource: 0 });
    root.querySelector("#gather").click();
    root.querySelector("#gather").click();
    expect(root.querySelector("#total").textContent).toBe("2");
  });
});
EOF

run_against() {
  cp "$WORK/$1.mjs" "$WORK/subject.mjs"
  (cd "$WORK" && "$VITEST" run --reporter=junit --outputFile="$WORK/$1.xml" >/dev/null 2>&1) || true
  python3 - "$WORK/$1.xml" <<'PY'
import sys, xml.etree.ElementTree as ET
root = ET.parse(sys.argv[1]).getroot()
print(root.get("tests"), root.get("failures"))
PY
}

echo "toolchain: $("$VITEST" --version)"

read -r alive_tests alive_failures < <(run_against alive)
echo "working UI:   ${alive_tests} test(s), ${alive_failures} failure(s)"

read -r dead_tests dead_failures < <(run_against dead)
echo "run 7's UI:   ${dead_tests} test(s), ${dead_failures} failure(s)"
grep -o 'message="[^"]*"' "$WORK/dead.xml" | sed 's/^/  /' || true

fail=0
[ "$alive_failures" = "0" ] || { echo "FAIL: the working UI should pass" >&2; fail=1; }
[ "$alive_tests" = "3" ]    || { echo "FAIL: expected 3 tests, got $alive_tests" >&2; fail=1; }
# 正確な件数は要点ではない。捕まえられるかどうかが要点だ。「0 より多い」に
# しておけば、上にテストを足しても壊れない。
[ "${dead_failures:-0}" -gt 0 ] || { echo "FAIL: a dead UI went unnoticed" >&2; fail=1; }

if [ "$fail" -eq 0 ]; then
  echo "smoke-dom: ok。画面の無い機械が、動く UI と死んだ UI を見分けられる"
else
  echo "smoke-dom: BROKEN" >&2
fi
exit "$fail"
