#!/usr/bin/env python3
"""エージェントではなく、1回の問い合わせで動くソルバーのバックエンド。

    solver-local <brief-file> <seconds>

ランナーが名前 `local` を渡すと、solver-run がこれを呼ぶ。cwd はすでに
/srv/loop/project、uid はすでに `solver` になっている。どちらも solver-run が
決めることで、このスクリプトは触らない。

なぜエージェントの CLI にしないか
--------------------------------
エージェントの仕組みがふつう担うこと、つまり終わりを決める、テストが通るかを
確かめる、やり直す、はすべてランナーがすでに担っていて、言いくるめられない形で
担っている。この中でもう1つループを回せば、それを全部重ねることになり、重ねた
部分はどれも、小さなモデルが「ランナーから見えない場所で」失敗しうる場所になる。
だから、1回問い合わせ、ファイルを丸ごと受け取り、終わる。ツールも、探索も、
テストの実行も、やり直しも無い。

差分ではなくファイルを丸ごと受け取るのも同じ理由による。小さなモデルがコードを
編集するとき最も多い失敗は、hunk の見出しが当てはまらない unified diff だ。
ファイル丸ごとなら、その失敗は形の上で起こりえない。それを安全にしているのは、
ランナーが後でパスを確かめること（`assert_touched`）と、計画が `files_write` を
小さく保つことだ。

何が何を費やすか（ここでの要の設計判断）
----------------------------------------
このスクリプトの非ゼロ終了はランナーで `Halt` になり、Halt はエスカレーションに
なり、エスカレーションはプランナーの呼び出しを1回使う。だから終了コードは出来の
報告ではなく、誰が払うかの選択だ:

    モデルが役に立たないことをした -> exit 0。試行を1回使い、VERIFY が落ち、
                                     ループがもう一度引く。安い。
    機械の側がおかしい             -> 非ゼロ。やり直しても直らず、人が見る必要が
                                     ある。すぐにそう言うのが一番安い。

壊れた JSON、許可リスト外のパス、空のファイルは、モデルが仕事を下手にこなした
ということで、プランナーに届いてはならない。サーバに届かない、ブリーフの形が
想定と違う、プロンプトがコンテキストより長い、は機械の側がおかしいということで、
黙って9回やり直してはならない。
"""

from __future__ import annotations

import json
import os
import re
import signal
import sys
import urllib.error
import urllib.request
from pathlib import Path

# --------------------------------------------------------------------------
# 調整する値。変えたくなりそうなものは、すべてこのまとまりにある。
# --------------------------------------------------------------------------

ENDPOINT = os.environ.get("LOOP_LLM_ENDPOINT", "http://127.0.0.1:8080")
MODEL = os.environ.get("LOOP_LLM_MODEL", "local")

# 0 にはしない。好みの問題ではない。`policy.retry: "resample"` は試行の予算を
# 「独立した抽選」に使う。温度 0 では、どの抽選も同じ抽選になり、予算全部で
# 答えを1つしか買えない。retry を "repair" にするなら、低くてよい。
#
# ただし高くもしない。0.7 では、やり直しのたびに2度目の挑戦ではなく新しい抽選に
# なった。run 8 の S1 は同じブリーフから9回拒否され、そのうち少なくとも5回は
# 抽選だけで説明がつく。単一引用符で囲んだテスト名の中にアポストロフィがある
# テストファイルが2回、たまたまスタブに対して通った条件が3回。ある抽選では
# 12件のテストと12件の失敗が RED_GATE をきれいに通り、同じブリーフからの次の
# 抽選は通らなかった。
#
# ここではばらつきは要らない。テストファイルは一度正しく書ければよい。
# policy.retry = "resample" は、ばらつきが役に立つところ、つまり IMPL の試行で
# すでにそれを与えている。行き詰まった実装に別の角度を与えることが、そこでの
# 狙いだ。IMPL より前はすべて書き写しで、書き写しは退屈なほうがよい。
TEMPERATURE = float(os.environ.get("LOOP_LLM_TEMPERATURE", "0.2"))
TOP_P = float(os.environ.get("LOOP_LLM_TOP_P", "0.9"))

# サーバを起動したときの値（llm-serve が --ctx-size で渡す）、つまり llm-serve の
# 既定と一致させる。これが防ぐ失敗は黙って起きる。上限を超えたプロンプトは、
# ブリーフの半分から書かれた自信ありげな誤答として返り、出来の悪いモデルと
# まったく同じに見える。一致させるべき2つの数が2つのファイルにあるのは良い
# 配置ではない。しかし代わりにサーバへ起動時の値を訊くと、それ自体が失敗しうる
# 問い合わせになる。この経路の仕事は、収まらないプロンプトに何分も使う前に
# 断ることだ。
CTX_TOKENS = int(os.environ.get("LOOP_LLM_CTX", "16384"))
# 出力に予約するのは、ループが実際に出す量に合わせる。run 8 の S1 は2つの
# ファイルを書き、中身は全部で約 960 トークンだった。4096 を予約していたときは、
# 5051 トークンのブリーフが、窓に 3000 トークンの空きを残したまま断られた。
#
# 2560 は選んだ値ではなく測った値で、これまでのステップが出したファイル丸ごとの
# 答えの最大に余裕を足したもの。少なく予約して外れても安全だ。途中で切れた答えは
# 正しい JSON にならず、solver-local は読み取りで失敗し、そう言う。多く予約して
# 外れると逆向きに失敗する。収まったはずの仕事を断り、その失敗は仕事のできない
# モデルに見える。
MAX_OUTPUT_TOKENS = int(os.environ.get("LOOP_LLM_MAX_OUTPUT", "2560"))

# 大まかで、あえて悲観的な値。コードも日本語も、1トークンあたり3文字を下回る。
# 始まる前から切り捨てが決まっている生成に何分も使う前に、断るためだけに使う。
CHARS_PER_TOKEN = 2.6

# 思考の経路は、モデルに考えるなと頼むのではなく、チャットテンプレートで切る。
# 指示は要請で、9B は要請を破る。思考の経路を持たないテンプレートは、それを
# 出せない。このシステムのほかの部分と同じ理屈で、誤用を見つけるのではなく
# できること自体を取り上げる。llama.cpp はこれを Jinja のテンプレートに渡す
# （Qwen3 が読む）。
CHAT_TEMPLATE_KWARGS = {"enable_thinking": False}

# 終了コード。ランナーが意味を読むのは 0 と 124 の2つ。残りは読む人間のための
# もので、どれも LOCAL_SOLVER.md に直し方と一緒に載っている。
EXIT_OK = 0
EXIT_USAGE = 2
EXIT_BRIEF_SHAPE = 5
EXIT_CONTEXT = 6
EXIT_SERVER = 7
EXIT_TIMEOUT = 124

FILES_HEADING = "# Files you may create or modify"

SCHEMA = {
    "type": "object",
    "properties": {
        "files": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {"path": {"type": "string"}, "content": {"type": "string"}},
                "required": ["path", "content"],
                "additionalProperties": False,
            },
        },
        "note": {"type": "string"},
    },
    "required": ["files"],
    "additionalProperties": False,
}

# 言語は、ブリーフが許すパスから取る。ここで言語について間違えようのない、
# 唯一のものだからだ。
#
# この1行を常に "You write Python files." にしていたとき、run 8 はその
# システムプロンプトのままモデルに TypeScript の契約を渡し、ローカルモデルが
# なぜ TypeScript に弱いのかを考えてエスカレーションを7回使った。モデルは
# `export` の無い関数を書いた。伝えられた言語では、それでまったく正しい。
# モジュールの最上位の def は import できるからだ。「小さなモデルは TypeScript に
# 弱いのか」という問いは立てられなかった。誰も TypeScript を頼んでいなかった。
LANGUAGE_BY_SUFFIX = {
    ".py": ("Python", ""),
    ".ts": ("TypeScript", """
- TypeScript, not Python. A declaration is only visible to another module if it
  says `export`; write `export function`, `export interface`, `export const`.
  A function without it exists and cannot be imported, and the test that
  imports it fails with a TypeError rather than an assertion.
- Strings in test names: use double quotes or backticks. The text you are given
  is English prose and contains apostrophes.
"""),
}


def system_prompt(allowed: list[str]) -> str:
    suffixes = {os.path.splitext(p)[1] for p in allowed}
    name, extra = next(
        (LANGUAGE_BY_SUFFIX[s] for s in (".ts", ".py") if s in suffixes),
        ("Python", ""))
    return f"""You write {name} files. You are given one task and the exact list of
files you may write. Return the COMPLETE final content of each file you change.

Rules:
- Only paths from the given list. A path not on the list is discarded.
- Whole file contents, never a diff, never an excerpt, never "unchanged".
- No explanation outside the JSON.
- If a file already has content, your version replaces it entirely, so carry
  over everything that must survive.{extra}"""


def die(code: int, message: str) -> None:
    """非ゼロで終わるときは、何が起きたかと、どうすればよいかを必ず言う。

    このプロジェクトで高くつく失敗は、壊れた走行ではなく、原因を突き止めるのに
    3往復の質問が要る壊れた走行だ。だから、ここのエラーは症状だけで終わらせない。
    """
    print(f"solver-local: {message}", file=sys.stderr)
    sys.exit(code)


def files_from_brief(brief: str) -> list[str]:
    """ブリーフが許すパスを、3つのブリーフが共通に使う見出しから読む。

    TEST_WRITE、STUB、IMPL は別々のブリーフで、たまたまこの見出しで揃っている
    （loop.py の `brief_test_write`、`brief_stub`、`brief_impl`）。この一致は要なのに
    どこにも宣言されていない。だから、もし崩れたら、黙って何も書かないのではなく
    断る。黙って何もしないバックエンドは、そのステップの試行を全部使い、問題を
    解けなかったモデルとして報告される。
    """
    if FILES_HEADING not in brief:
        die(EXIT_BRIEF_SHAPE,
            f"the brief has no {FILES_HEADING!r} section.\n"
            "  loop.py's brief format changed and this backend was not updated.\n"
            "  Fix: compare with brief_impl() in runner/loop.py.")
    tail = brief.split(FILES_HEADING, 1)[1]
    paths = []
    for line in tail.splitlines():
        line = line.strip()
        if not line:
            if paths:
                break
            continue
        if line.startswith("#"):
            break
        # 一覧は1行に1つずつの素のパス。空白を含むものは一覧の後に続く文で、
        # パスではない。
        if " " in line:
            break
        paths.append(line)
    if not paths:
        die(EXIT_BRIEF_SHAPE,
            f"the {FILES_HEADING!r} section listed no paths.\n"
            "  Fix: check the step's files_write / files_test in plan/tasks.json.")
    return paths


def current_contents(paths: list[str]) -> str:
    """許されたファイルの、いまの中身。

    このバックエンドはリポジトリを読みに行かないので要る。問い合わせは1回で、
    探しに行けない。codex は探しに行けるので、brief_impl はこれを運ばない。
    ブリーフに足すのではなくここで読むことで、ブリーフの約束（1ステップ分の
    情報だけ）は変わらない。
    """
    parts = []
    for rel in paths:
        p = Path(rel)
        if p.is_file():
            parts.append(f"--- {rel} ---\n{p.read_text(encoding='utf-8')}")
        else:
            parts.append(f"--- {rel} ---\n(does not exist yet)")
    return "\n\n".join(parts)


def post(path: str, payload: dict | None, seconds: float) -> dict:
    url = ENDPOINT.rstrip("/") + path
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        url, data=data, method="POST" if data else "GET",
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=seconds) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")[:800]
        die(EXIT_SERVER,
            f"the inference server rejected the request ({e.code}) at {url}\n"
            f"  {body}\n"
            "  Fix: if it names an unknown field, the server is older than this\n"
            "  script expects -- see LOCAL_SOLVER.md, 'server too old'.")
    except urllib.error.URLError as e:
        die(EXIT_SERVER,
            f"cannot reach the inference server at {url}: {e.reason}\n"
            "  Fix: sudo -u llm /srv/loop/bin/llm-serve   (or check it is still up:\n"
            "       pgrep -a -u llm llama-server)")
    except json.JSONDecodeError:
        die(EXIT_SERVER, f"the server at {url} did not answer with JSON.")
    raise AssertionError("unreachable")


def main() -> int:
    if len(sys.argv) < 2:
        die(EXIT_USAGE, "usage: solver-local <brief-file> [seconds]")
    brief_path = Path(sys.argv[1])
    seconds = int(sys.argv[2]) if len(sys.argv) > 2 else 900

    # solver-run はこのスクリプトを `timeout` で包まずに exec する。バックエンドが
    # 自分で上限を掛けるのが solver-run との約束だからだ。124 は適当な番号では
    # ない。call_solver はそれを「ソルバーが自分の時間切れに当たった」と読み、
    # 「ソルバーが落ちた」とは別の意味になる。
    def out_of_time(_sig, _frm):
        die(EXIT_TIMEOUT,
            f"no answer within {seconds}s.\n"
            "  A local 9B on CPU does not finish a step in this budget. Fix:\n"
            "  raise timeouts.solver in plan/tasks.json, or give the server a GPU.")
    signal.signal(signal.SIGALRM, out_of_time)
    signal.alarm(seconds)

    if not brief_path.is_file():
        die(EXIT_USAGE, f"cannot read brief: {brief_path}")
    brief = brief_path.read_text(encoding="utf-8")
    allowed = files_from_brief(brief)

    user = (brief
            + "\n\n# Current contents of the files you may write\n"
            + current_contents(allowed)
            + "\n\n# Output\nReturn JSON: the complete final content of every file"
              " you are changing. Only these paths:\n"
            + "\n".join(allowed) + "\n")

    system = system_prompt(allowed)
    estimated = int((len(system) + len(user)) / CHARS_PER_TOKEN)
    room = CTX_TOKENS - MAX_OUTPUT_TOKENS
    if estimated > room:
        # 送らずに断る。上限を超えると、サーバはエラーを返すか、黙ってプロンプトの
        # 前を落とす。黙って落とすと、ブリーフの半分から書かれた自信ありげな答えが
        # 返り、外からは単に出来の悪いモデルと区別がつかない。
        die(EXIT_CONTEXT,
            f"prompt is about {estimated} tokens and only {room} fit "
            f"(ctx {CTX_TOKENS} minus {MAX_OUTPUT_TOKENS} reserved for output).\n"
            "  Fix, cheapest first: raise --ctx-size in bin/llm-serve and\n"
            "  LOOP_LLM_CTX to match; or split the step so files_write and its\n"
            "  tests are smaller (see LOCAL_SOLVER.md, 'the step is too big').")

    body = post("/v1/chat/completions", {
        "model": MODEL,
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": user}],
        "temperature": TEMPERATURE,
        "top_p": TOP_P,
        "max_tokens": MAX_OUTPUT_TOKENS,
        # 書式の依頼ではなく、制約付きのデコード。この大きさのモデルで使える、
        # 最も大きな信頼性の梃子だ。出せない形は、身構えて読み取る必要もない。
        "response_format": {"type": "json_schema",
                            "json_schema": {"name": "files", "strict": True,
                                            "schema": SCHEMA}},
        "chat_template_kwargs": CHAT_TEMPLATE_KWARGS,
        # llama.cpp は続けて来た問い合わせの共通の前半を覚えておく。1つのステップの
        # 試行は末尾しか違わないので、実時間の大半がこれで浮く。
        "cache_prompt": True,
    }, seconds=max(30, seconds - 15))

    used = (body.get("usage") or {}).get("prompt_tokens")
    if used and used > CTX_TOKENS:
        die(EXIT_CONTEXT,
            f"the server read {used} prompt tokens with a context of {CTX_TOKENS}; "
            "the front of the brief was dropped.\n"
            "  Fix: raise --ctx-size in bin/llm-serve and LOOP_LLM_CTX to match.")

    text = ((body.get("choices") or [{}])[0].get("message") or {}).get("content") or ""

    # -- ここから下は、非ゼロで終わらない ------------------------------------
    # ここから下はすべて、モデルが仕事を下手にこなした場合で、それは試行を1回
    # 使うべきもので、エスカレーションにしてはならない。エスカレーションに
    # 答えるのはプランナーで、プランナーは高くつくアカウントだ。
    print(f"[solver-local] {MODEL} temp={TEMPERATURE} prompt~{estimated}tok "
          f"used={used} out={len(text)}ch")

    if "<think>" in text:
        # 致命的ではないが、一度ははっきり言う価値がある。テンプレートにまだ
        # 思考の経路があり、問い合わせのたびにトークンをそこに使っている。
        print("[solver-local] WARNING: <think> in the output -- enable_thinking "
              "did not take effect. See LOCAL_SOLVER.md, 'thinking is still on'.",
              file=sys.stderr)
        text = re.sub(r"<think>.*?</think>", "", text, flags=re.S)

    try:
        answer = json.loads(text)
        entries = answer["files"]
    except (json.JSONDecodeError, KeyError, TypeError):
        print("[solver-local] the answer was not the agreed JSON; writing nothing. "
              "This attempt is spent.", file=sys.stderr)
        print(text[:800], file=sys.stderr)
        return EXIT_OK

    allowed_set = set(allowed)
    written, refused = [], []
    for entry in entries:
        rel = str(entry.get("path", "")).lstrip("./")
        content = entry.get("content")
        if rel not in allowed_set or not isinstance(content, str) or not content.strip():
            refused.append(rel or "(no path)")
            continue
        target = Path(rel)
        target.parent.mkdir(parents=True, exist_ok=True)
        if not content.endswith("\n"):
            content += "\n"
        target.write_text(content, encoding="utf-8")
        written.append(rel)

    print(f"[solver-local] wrote {written or 'nothing'}"
          + (f"; refused {refused}" if refused else ""))
    if refused and not written:
        # はっきり言う。何も起きていないように見える失敗だからだ。ステップは
        # 同じ VERIFY の失敗を出し続けて予算を全部使い、台帳は理由を言わない。
        print("[solver-local] every path was outside the allowlist. The step will "
              "fail VERIFY unchanged.", file=sys.stderr)
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
