#!/usr/bin/env bash
# 箱の操作をまとめたコマンド。保守ユーザーが流す。25-runner.sh が
# /usr/local/bin/loop に置く。
#
# コマンドの一覧は usage() を参照。
#
# 走行は systemd の一時ユニット loop-run で、runner として動く。`sudo ... &` で裏に
# 回すと、SSH が切れたときに sudo が受けた SIGHUP を中のコマンドへ中継し、走行が
# 止まる。一時ユニットは SSH のセッションから切り離されている。ユニット名が1つ
# なので二重には起動できず、止めるときは3役の呼び出しも含めてまとめて止まる。
set -euo pipefail

# LOOP_ROOT はテストのためだけにある。走行は systemd のユニットで動き、呼んだ人の
# 環境を受け継がないので、裏で走る側には効かない。
LOOP="${LOOP_ROOT:-/srv/loop}"
UNIT=loop-run
LOGS=$LOOP/logs
REQUIREMENTS=$LOOP/human/in/REQUIREMENTS.md
PENDING=$LOOP/planner/out/tasks.json
CRITIQUE=$LOOP/human/in/CRITIQUE.json
PLAN=$LOOP/project/plan
ENGINE="${LOOP_ENGINE:-/opt/loop-engine}"
PROJECT_SH="$ENGINE/provision/loop-project.sh"
DASH_PY="$ENGINE/provision/loop_dash.py"
SELF=/usr/local/bin/loop
# ダッシュボードからのプロジェクトの切り替え。初めてのプロジェクトはプロビジョニングで
# 数分かかるので、走行と同じく一時ユニットで裏に回す。
SWITCH_UNIT=loop-switch
SWITCH_LOG=$LOGS/switch.log
ROLE_ENV=/etc/loop

# 保守ユーザーのホームは 0700 で、runner はそこに cd できない（provision/README §3-14）。
cd /tmp

die() { echo "loop: $*" >&2; exit 1; }

project_name() {
  local name
  name="$(cat "$LOOP/projects/CURRENT" 2>/dev/null || true)"
  echo "${name:-default}"
}

running() { systemctl is-active --quiet "$UNIT"; }

switching() { systemctl is-active --quiet "$SWITCH_UNIT"; }

latest_log() { echo "$LOGS/$(project_name)-latest.log"; }

as_runner() { sudo -u runner "$@"; }

# ---- 裏で走る側。runner として動く ------------------------------------------

# loop.py を1つ呼び、終了コードを返す。何を呼んだかをログに残す。
step() {
  echo
  echo "--- loop.py $* ($(date '+%F %T'))"
  python3 -u "$LOOP/runner/loop.py" "$@"
}

# 行頭の `=== loop ` は、`loop status` と `loop now` が結果の行を探す目印。
# 変えるときは両方を合わせる。
finish() {
  echo
  echo "=== loop 終了 ($(date '+%F %T')): $2"
  exit "$1"
}

apply_pending() {
  local rc=0
  step plan apply || rc=$?
  case "$rc" in
    0) ;;
    2) finish 2 "提案が拒まれた。提案は $LOOP/planner/out に残っている。上の違反を読む" ;;
    3) finish 3 "プランナーがあんたに判断を返した。$PLAN/PLANNER_ESCALATION.md を読む" ;;
    *) finish "$rc" "plan apply が失敗した（終了コード $rc）" ;;
  esac
}

# 上限まで改訂しても指摘が残れば 4 で、改訂の途中でプランナーが判断を返せば 3 で止まる。
# 人がダッシュボードか 'loop findings set' で指摘を書き換えてから 'loop continue' を流すと、
# --resume が書き換えた指摘で1回だけ改訂させる。書き換えが無ければ何もしない。どちらも、
# その後に提案を適用する。
refine() {
  local rc=0
  step plan refine "$@" || rc=$?
  case "$rc" in
    0) ;;
    3) finish 3 "plan refine の途中でプランナーが判断を返した。$LOOP/project/.runner/refine-escalation.md を読み、答えを指摘に書き込むならダッシュボードか 'loop findings set'。次は 'loop continue'" ;;
    4) finish 4 "クリティックの指摘が残った。直すならダッシュボードか 'loop findings set'。直しても直さなくても、次は 'loop continue'" ;;
    *) finish "$rc" "plan refine が失敗した（終了コード $rc）" ;;
  esac
}

run_all() {
  local rc=0
  step run --all || rc=$?
  case "$rc" in
    0) finish 0 "全ステップが緑になった" ;;
    5) finish 5 "利用枠が尽きた。枠が戻ったら 'loop continue'。途中のステップがあれば先に 'loop raw reset <ステップ>'" ;;
    *) finish "$rc" "run --all が止まった（終了コード $rc）。'loop status' を見る" ;;
  esac
}

work() {
  local log="$1" mode="$2" language="${3:-python}" rc=0
  exec >>"$log" 2>&1
  echo "=== loop $mode 開始 ($(date '+%F %T')) プロジェクト=$(project_name)"

  if [ "$mode" = go ]; then
    step plan bootstrap --language "$language" || rc=$?
    [ "$rc" -eq 0 ] || finish "$rc" "plan bootstrap が失敗した（終了コード $rc）"
    if [ -f "$LOOP/planner/out/ESCALATE.md" ]; then
      finish 3 "プランナーが計画を書かずに判断を返した。$LOOP/planner/out/ESCALATE.md を読む"
    fi

    refine
    apply_pending
  elif [ -f "$PENDING" ]; then
    # 人を待つ批評が無ければ、--resume は何もせずに 0 で戻り、提案を適用する。
    refine --resume
    apply_pending
  fi
  run_all
}

# ---- 保守ユーザーが打つ側 ----------------------------------------------------

start() {
  local mode="$1" language="${2:-}" log
  running && die "もう走っている。追うなら 'loop log'、止めるなら 'loop stop'"
  switching && die "プロジェクトを切り替えている。終わるのを待つ"
  log="$LOGS/$(project_name)-$(date +%Y%m%d-%H%M%S).log"
  as_runner touch "$log"
  as_runner ln -sfn "$(basename "$log")" "$(latest_log)"
  sudo systemd-run --quiet --collect --unit="$UNIT" \
    --uid=runner --gid=runner --working-directory=/tmp \
    "$SELF" __work "$log" "$mode" ${language:+"$language"}
  echo "裏で走らせた。ログ: $log"
  echo "追うなら 'loop log'、状態を見るなら 'loop status'"
}

cmd_go() {
  local requirements="" language="python"
  while [ $# -gt 0 ]; do
    case "$1" in
      --language) [ $# -ge 2 ] || die "--language に値が無い"; language="$2"; shift 2 ;;
      -*) die "知らないオプション: $1" ;;
      *) [ -z "$requirements" ] || die "要件のファイルは1つだけ渡す"; requirements="$1"; shift ;;
    esac
  done
  [ -n "$requirements" ] || die "使い方: loop go <要件>.md [--language <言語>]"
  [ -f "$requirements" ] || die "ファイルが無い: $requirements"
  [ -d "$(dirname "$REQUIREMENTS")" ] || die "$(dirname "$REQUIREMENTS") が無い。プロジェクトは作ってある？"
  running && die "もう走っている。先に 'loop stop'"

  sudo install -o root -g humanw -m 644 "$requirements" "$REQUIREMENTS"
  echo "要件を置いた: $REQUIREMENTS"
  start go "$language"
}

cmd_continue() {
  as_runner test -f "$PLAN/tasks.json" || as_runner test -f "$PENDING" \
    || die "まだ計画が無い。'loop go <要件>.md' から始める"
  start continue
}

cmd_status() {
  local log last
  echo "プロジェクト: $(project_name)"
  if running; then
    echo "走行:         走っている"
  else
    echo "走行:         止まっている"
  fi

  log="$(latest_log)"
  if [ -e "$log" ]; then
    echo "ログ:         $(readlink -f "$log")"
    last="$(grep -E '^=== loop ' "$log" | tail -n 1 || true)"
    [ -z "$last" ] || echo "最後:         ${last#=== }"
  fi

  as_runner test -f "$PENDING" && echo "適用待ち:     $LOOP/planner/out に提案がある（'loop continue' で適用する）"
  local f
  for f in ESCALATION.md PLANNER_ESCALATION.md; do
    if as_runner test -f "$PLAN/$f"; then
      echo
      echo "--- $PLAN/$f（先頭20行）"
      as_runner head -n 20 "$PLAN/$f"
    fi
  done

  if as_runner test -f "$PLAN/ledger.jsonl"; then
    echo
    echo "--- 台帳（最後の5件）"
    as_runner tail -n 5 "$PLAN/ledger.jsonl"
  fi
}

# ランナーが書く now.json に、走っているかどうか、最後の結果、今の回のトークン数と
# クリティックの指摘を足して1つの JSON にする。sudo を使わない。中身は loop_now.py。
cmd_now() {
  local active=false moving=false
  running && active=true
  switching && moving=true
  python3 "$ENGINE/provision/loop_now.py" "$(project_name)" "$active" "$LOGS" "$moving"
}

# プロジェクトの切り替えを一時ユニットで裏に回す。出力は switch.log に書き、`loop now` が
# 末尾を返す。root で動く（cmd_dash から呼ぶ）。
switch_project() {
  local name="$1" admin="$2"
  running && die "走っている間は切り替えられない。先に止める"
  switching && die "もう切り替えている"
  : > "$SWITCH_LOG"
  systemd-run --quiet --collect --unit="$SWITCH_UNIT" --working-directory=/tmp \
    --setenv=ADMIN_USER="$admin" \
    --property=StandardOutput="append:$SWITCH_LOG" \
    --property=StandardError="append:$SWITCH_LOG" \
    bash "$PROJECT_SH" use "$name"
  echo "'$name' への切り替えを裏で始めた"
}

# 取り込むプロジェクトの空の bare を用意する。root で動く（cmd_dash から呼ぶ）。
# 柵の場所は空なら渡さず、loop-project.sh の既定に任せる。
init_project() {
  local name="$1" branch="$2" src="$3" tests="$4" admin="$5"
  local -a args=(init "$name" --branch "$branch")
  switching && die "ダッシュボードがプロジェクトを切り替えている。終わるのを待つ"
  [ -z "$src" ] || args+=(--src "$src")
  [ -z "$tests" ] || args+=(--tests "$tests")
  ADMIN_USER="$admin" bash "$PROJECT_SH" "${args[@]}"
}

# ホストのダッシュボードが流す入口。sudoers が保守ユーザーにこれだけをパスワード無しで
# 許す（25-runner.sh）ので、root で動く。要求は標準入力の JSON 1つで、形と値は
# loop_dash.py が確かめる。ここでは確かめ済みの行だけを使う。
cmd_dash() {
  local admin="${SUDO_USER:-}" work action
  local -a req
  [ "$(id -u)" -eq 0 ] || die "dash は 'sudo -n $SELF dash' で流す"
  [ -n "$admin" ] && [ "$admin" != root ] || die "dash は保守ユーザーが sudo で流す"
  work="$(mktemp -d)"
  # パスは trap を仕掛けるときに埋め込む。EXIT で動くころには local はもう無い。
  trap "rm -rf -- '$work'" EXIT
  python3 "$DASH_PY" request "$work" > "$work/request"
  mapfile -t req < "$work/request"
  action="${req[0]:-}"
  case "$action" in
    settings) python3 "$DASH_PY" settings "$ROLE_ENV" ;;
    model)    python3 "$DASH_PY" set-model "$ROLE_ENV" "${req[1]}" "${req[2]}" "${req[3]}" ;;
    go)       cmd_go "$work/requirements.md" --language "${req[1]}" ;;
    continue) cmd_continue ;;
    stop)     cmd_stop ;;
    use)      switch_project "${req[1]}" "$admin" ;;
    init)     init_project "${req[1]}" "${req[2]}" "${req[3]}" "${req[4]}" "$admin" ;;
    *)        die "知らない操作: $action" ;;
  esac
}

# クリティックの指摘を見せ、直す。sudo を使わない。写しはグループ humanw に
# 書き込みを許してある。中身は loop_findings.py。
cmd_findings() {
  case "${1:-show}" in
    show) python3 "$ENGINE/provision/loop_findings.py" show "$CRITIQUE" ;;
    set)
      running && die "走っている間は直せない"
      python3 "$ENGINE/provision/loop_findings.py" set "$CRITIQUE" ;;
    *) die "使い方: loop findings [show | set]" ;;
  esac
}

cmd_log() {
  local log
  log="$(latest_log)"
  [ -e "$log" ] || die "プロジェクト '$(project_name)' のログはまだ無い"
  tail -n 50 -F "$log"
}

cmd_stop() {
  running || { echo "走っていない"; return 0; }
  sudo systemctl stop "$UNIT"
  echo "止めた。"
  echo "途中のステップはそのまま残っている。'loop continue' の前に次を流す:"
  echo "    loop raw reset <ステップ>"
}

# このリポジトリを pull し、プロビジョニングを流し直す。最後にプロビジョニングが通った
# コミット（provision.sh が書く）が今のコミットと同じなら、--force が無い限り飛ばす。
# プロビジョニングはこのファイル自身を置き直すので、exec で最後に渡す。bash はスクリプトを
# 読みながら実行するため、置き直された後の行を読ませない。
cmd_update() {
  local force=false head
  [ $# -le 1 ] || die "使い方: loop update [--force]"
  case "${1:-}" in
    "") ;;
    --force) force=true ;;
    *) die "使い方: loop update [--force]" ;;
  esac
  running && die "走っている間は更新できない。先に 'loop stop'"
  switching && die "ダッシュボードがプロジェクトを切り替えている。終わるのを待つ"
  sudo git -C "$ENGINE" pull --ff-only
  # リポジトリは root のものなので、保守ユーザーの git は所有者の違いで断る。
  head="$(sudo git -C "$ENGINE" rev-parse HEAD)"
  if ! $force && [ "$head" = "$(cat "$ROLE_ENV/provisioned" 2>/dev/null || true)" ]; then
    echo "このコミットはプロビジョニング済み。流し直すなら 'loop update --force'"
    return 0
  fi
  exec sudo ADMIN_USER="$(id -un)" bash "$ENGINE/provision/provision.sh"
}

usage() {
  cat >&2 <<'EOF'
使い方: loop <コマンド>

  go <要件>.md [--language <言語>]
                    要件を置き、計画づくりから全ステップまでを裏で流す
  continue          直したクリティックの指摘があればプランナーに渡し、適用待ちの
                    提案を適用して、全ステップを裏で流す
  status            プロジェクト、走っているか、人への問い、台帳の末尾を出す
  now               いまの作業を JSON で出す（ホストのダッシュボードが読む）
  findings          クリティックの指摘を出す
  findings set      指摘1件の title と evidence を書き換える。標準入力に
                    {"mode", "index", "title", "evidence"} の JSON を渡す
  log               走行ログを追う。Ctrl-C で抜けても走行は続く
  stop              走行を止める
  project <引数>    プロジェクトの一覧と切り替え。'loop project' で使い方を出す
  raw <引数>        loop.py をそのまま runner として前面で呼ぶ。'loop raw --help' で動詞の一覧
  update [--force]  このリポジトリを pull し、プロビジョニングを流し直す。プロビジョニング済みの
                    コミットなら、--force が無い限り飛ばす
  dash            ホストのダッシュボードの入口。'sudo -n /usr/local/bin/loop dash' で流し、
                    標準入力に要求の JSON を渡す
EOF
  exit 2
}

case "${1:-}" in
  go)       shift; cmd_go "$@" ;;
  continue) cmd_continue ;;
  status)   cmd_status ;;
  now)      cmd_now ;;
  findings) shift; cmd_findings "$@" ;;
  log)      cmd_log ;;
  stop)     cmd_stop ;;
  project)
    shift
    switching && die "ダッシュボードがプロジェクトを切り替えている。終わるのを待つ"
    sudo ADMIN_USER="$(id -un)" bash "$PROJECT_SH" "$@" ;;
  raw)      shift; as_runner python3 -u "$LOOP/runner/loop.py" "$@" ;;
  update)   shift; cmd_update "$@" ;;
  dash)    [ $# -eq 1 ] || usage; cmd_dash ;;
  __work)   shift; work "$@" ;;
  *)        usage ;;
esac
