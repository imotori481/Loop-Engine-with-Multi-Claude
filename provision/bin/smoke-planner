#!/usr/bin/env bash
# ランナーはプランナーを動かせるか。プランナーは本当に柵の中にいるか。
#
#     sudo -u runner /srv/loop/bin/smoke-planner
#
# 後半のほうが大事だ。動くプランナーは簡単に作れる。要点は、設計を直接書けず、
# 既存のコードは読めても書けず、テストには届かないプランナーであること
# （BOOTSTRAP 1-1）。それを約束ではなく、ファイルシステムの事実として確かめる。
#
# 設計の何を変えてよいかは別の問いで、loop.py の検査（check_modules_out）が
# 受け持つ。
set -euo pipefail

[ "$(id -un)" = "runner" ] || { echo "run as runner: sudo -u runner $0" >&2; exit 1; }

BRIEF=/srv/loop/planner/brief/smoke.md
OUT=/srv/loop/planner/out
TARGET="$OUT/smoke-proposal.txt"
MARKER="planner-smoke-ok"

rm -f "$TARGET"

cat > "$BRIEF" <<EOF
Write a file named smoke-proposal.txt in the current directory containing
exactly this single line:

$MARKER

Do nothing else. Then reply with exactly: DONE
EOF

echo "--- invoking planner ---"
rc=0
sudo -u planner /srv/loop/bin/planner-run "$BRIEF" 180 || rc=$?
echo "--- planner exited rc=$rc ---"

fail=0
note() { echo "  $1"; }
bad()  { echo "  FAIL: $1"; fail=1; }

if [ ! -f "$TARGET" ]; then
  bad "the proposal file was not written"
else
  note "ok: proposal written"
  owner="$(stat -c '%U' "$TARGET")"
  if [ "$owner" = "planner" ]; then
    note "ok: proposal owned by planner"
  else
    bad "proposal owned by $owner, expected planner"
  fi
  if grep -Fqx "$MARKER" "$TARGET"; then
    note "ok: content matches"
  else
    bad "content does not match"
  fi
fi

# 柵は、実際に触ってみるのではなく、権限として確かめる。
#
# 素直な書き方の `sudo -u planner test -r ...` は、ここでは使えないうえに有害だ。
# このスクリプトは runner で動き、runner の sudo の許可は起動スクリプトだけ
# なので、sudo はそのコマンドを拒み、その失敗はファイルを拒まれたのとまったく
# 同じに見える。柵が全開でも、そうした検査はすべて「通る」。代わりにモードを
# 見る。runner はそのすべてを stat できる。
# docs/ と ac/ の 0700 が買うのは、プランナーが設計を「直接書けない」ことだ。
# 設計をプランナーから隠すためではない。プランナーは設計の書き手で、ランナーは
# 今の設計を out/ に写して渡す。書いたものは検査を通ってから戻る。
for d in plan docs ac; do
  mode="$(stat -c '%U:%G %a' "/srv/loop/project/$d")"
  if [ "$mode" = "runner:runner 700" ]; then
    note "ok: $d/ is runner:runner 700 -- every change goes through the runner"
  else
    bad "$d/ is '$mode', expected 'runner:runner 700'"
  fi
done

# 柵の場所。規則は loop.py の LAYOUT にしか書かないので、そこから読む。
read -r LAYOUT_SRC LAYOUT_TESTS <<<"$(python3 -B -c "import sys; sys.path.insert(0, '/srv/loop/runner'); import loop; print(loop.LAYOUT['src'], loop.LAYOUT['tests'])")"
planner_groups=" $(id -nG planner) "
for d in "$LAYOUT_SRC" "$LAYOUT_TESTS"; do
  grp="$(stat -c '%G' "/srv/loop/project/$d")"
  case "$planner_groups" in
    *" $grp "*) bad "planner is in group $grp, which owns $d/ -- it could write there" ;;
    *)          note "ok: planner is not in $grp, so it cannot write $d/" ;;
  esac
done

# 既存のコードは ACL で読める。書き込みのビットは持たない（40-perms.sh）。
# テストには ACL が無く、グループにもいないので届かない。
src_acl="$(getfacl -p --omit-header "/srv/loop/project/$LAYOUT_SRC" 2>/dev/null \
  | grep '^user:planner:' || true)"
case "$src_acl" in
  user:planner:r-x*) note "ok: planner reads $LAYOUT_SRC/ through its ACL, and cannot write it" ;;
  *)                 bad "the ACL of $LAYOUT_SRC/ for planner is '$src_acl', expected 'user:planner:r-x'" ;;
esac
if getfacl -p --omit-header "/srv/loop/project/$LAYOUT_TESTS" 2>/dev/null | grep -q '^user:planner:'; then
  bad "$LAYOUT_TESTS/ has an ACL entry for planner -- it must never see the tests"
else
  note "ok: $LAYOUT_TESTS/ has no ACL entry for planner"
fi

homemode="$(stat -c '%U %a' /home/planner)"
if [ "$homemode" = "planner 700" ]; then
  note "ok: /home/planner is 700 -- its credentials are its own"
else
  bad "/home/planner is '$homemode', expected 'planner 700'"
fi

rm -f "$TARGET" "$BRIEF"

echo
if [ "$fail" -eq 0 ]; then
  echo "smoke-planner: PASS"
else
  echo "smoke-planner: FAIL"
  exit 1
fi
