#!/usr/bin/env bash
# ランナーはプランナーを動かせるか。プランナーは本当に柵の中にいるか。
#
#     sudo -u runner /srv/loop/bin/smoke-planner
#
# 後半のほうが大事だ。動くプランナーは簡単に作れる。要点は、計画を直接書けず、
# 計画を満たすべきコードにも触れられないプランナーであること（BOOTSTRAP 1-1）。
# それを約束ではなく、ファイルシステムの事実として確かめる。
#
# 計画の何を変えてよいかは別の問いで、smoke-plan が `loop.py plan apply` の
# 検査として確かめる。
set -euo pipefail

[ "$(id -un)" = "runner" ] || { echo "run as runner: sudo -u runner $0" >&2; exit 1; }

BRIEF=/srv/loop/planner/brief/smoke.md
OUT=/srv/loop/planner/out
TARGET="$OUT/smoke-proposal.txt"
MARKER="planner-smoke-ok"

rm -f "$TARGET"

cat > "$BRIEF" <<EOF
Write a file named smoke-proposal.txt in the current directory containing
exactly this single line:

$MARKER

Do nothing else. Then reply with exactly: DONE
EOF

echo "--- invoking planner ---"
rc=0
sudo -u planner /srv/loop/bin/planner-run "$BRIEF" 180 || rc=$?
echo "--- planner exited rc=$rc ---"

fail=0
note() { echo "  $1"; }
bad()  { echo "  FAIL: $1"; fail=1; }

if [ ! -f "$TARGET" ]; then
  bad "the proposal file was not written"
else
  note "ok: proposal written"
  owner="$(stat -c '%U' "$TARGET")"
  if [ "$owner" = "planner" ]; then
    note "ok: proposal owned by planner"
  else
    bad "proposal owned by $owner, expected planner"
  fi
  if grep -Fqx "$MARKER" "$TARGET"; then
    note "ok: content matches"
  else
    bad "content does not match"
  fi
fi

# 柵は、実際に触ってみるのではなく、権限として確かめる。
#
# 素直な書き方の `sudo -u planner test -r ...` は、ここでは使えないうえに有害だ。
# このスクリプトは runner で動き、runner の sudo の許可は起動スクリプトだけ
# なので、sudo はそのコマンドを拒み、その失敗はファイルを拒まれたのとまったく
# 同じに見える。柵が全開でも、そうした検査はすべて「通る」。代わりにモードを
# 見る。runner はそのすべてを stat できる。
# plan/ の 0700 が買うのは、プランナーが tasks.json を「書けない」ことだ。受け入れ
# 条件をプランナーから隠すためではない。プランナーは条件の書き手で、改訂を頼む
# ときランナーは計画全体をブリーフで渡す。BOOTSTRAP 1-1 の分離は、条件を書く
# アカウントとコードを書くアカウントのあいだにあり、それが次の2つの検査だ。
planmode="$(stat -c '%U:%G %a' /srv/loop/project/plan)"
if [ "$planmode" = "runner:runner 700" ]; then
  note "ok: plan/ is runner:runner 700 -- every change goes through the runner"
else
  bad "plan/ is '$planmode', expected 'runner:runner 700'"
fi

planner_groups=" $(id -nG planner) "
for d in src tests; do
  grp="$(stat -c '%G' "/srv/loop/project/$d")"
  case "$planner_groups" in
    *" $grp "*) bad "planner is in group $grp, which owns $d/ -- it could write there" ;;
    *)          note "ok: planner is not in $grp, so $d/ is closed to it" ;;
  esac
done

homemode="$(stat -c '%U %a' /home/planner)"
if [ "$homemode" = "planner 700" ]; then
  note "ok: /home/planner is 700 -- its credentials are its own"
else
  bad "/home/planner is '$homemode', expected 'planner 700'"
fi

rm -f "$TARGET" "$BRIEF"

echo
if [ "$fail" -eq 0 ]; then
  echo "smoke-planner: PASS"
else
  echo "smoke-planner: FAIL"
  exit 1
fi
