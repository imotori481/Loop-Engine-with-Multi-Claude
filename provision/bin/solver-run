#!/usr/bin/env bash
# ソルバーのエージェントを、1つのブリーフに対して非対話で起動する。
#
# ランナーはこう呼ぶ:
#     sudo -u solver /srv/loop/bin/solver-run <brief-file> <seconds> [backend]
#
# ランナーは sudo を持たない（10-users.sh が確かめる）。
# /etc/sudoers.d/91-runner-to-solver の唯一の例外はこのスクリプトだけを名指しし、
# Runas (solver) に限る。横への移動で、昇格ではない。
set -euo pipefail

BRIEF="${1:?usage: solver-run <brief-file>}"

# エージェントを止めるまでの秒数。ランナーではなくここで強制する。ランナーは
# 別の uid で、このプロセスに信号をまったく送れない。上限をランナーの側だけで
# 掛けると、固まったエージェントが、誰にも止められないまま動き続ける。
# `timeout` は発動すると 124 で終わる。
LIMIT="${2:-900}"
[ -r "$BRIEF" ] || { echo "solver-run: cannot read brief: $BRIEF" >&2; exit 2; }

# どのバックエンドがこのブリーフを走らせるか。ランナーが渡すのは名前だけで、
# コマンドは渡さない。名前から実行ファイルへの対応はここ、ランナーが書けない
# root 所有のスクリプトにある。だからバックエンドを足すのは sudo を持つ人の
# 意図した行為で、計画やランナーが求められるものではない。
#
# 検証は文字の種類を見るだけで、それで足りなければならない。名前は下でパスに
# 埋め込まれるからだ。
# 名前を省略したときは claude（solver-claude）を使う。codex は名前を指定した
# ときだけ使う任意のバックエンドにする。
BACKEND="${3:-claude}"
case "$BACKEND" in
  ""|*[!a-z0-9]*) echo "solver-run: bad backend name: $BACKEND" >&2; exit 4 ;;
esac

# sudo の env_reset は、HOME を相手のユーザーのものに確実には変えない。codex は
# 資格情報の置き場を HOME から決める。これが無いと、ランナーのホームを探し、
# 何も見つけず、"Not logged in" と報告する。原因から遠い失敗だ。ランナーが
# 渡し忘れうる sudo のフラグに頼らず、ここで明示する。
export HOME=/home/solver

# codex 以外のバックエンドは、このスクリプトの隣に /srv/loop/bin/solver-<name>
# として置く。root 所有の 0755 で、同じ <brief> <seconds> の引数を取り、自分で
# `timeout` を掛ける。ソルバーを足すための接点はそれだけで（claude やローカル
# モデルなど）、あえてここで止めてある。書き込みの柵、ブリーフ1つだけの経路、
# 実行するアカウントは、何が動いても最初から正しい。どれもエージェントではなく、
# uid とファイルシステムの性質だからだ。
#
# 段を複数置ける理由: 先の段が試行を使い切ったとき、もう1つの道はエスカレーション
# で、それはプランナーの呼び出しを1回使う。次の段のソルバーは、次に起こりうる
# 2つのうち安いほうだ。
if [ "$BACKEND" != codex ]; then
  helper="/srv/loop/bin/solver-$BACKEND"
  [ -x "$helper" ] || {
    echo "solver-run: no backend '$BACKEND' ($helper is not executable)" >&2
    exit 4
  }
  # 先に作業ツリーへ移る。理由は下の `cd` に書いたとおり。sudo はランナーの
  # cwd をそのまま渡し、そのホームは 0700 だ。自分の作業ディレクトリをたどれない
  # プロセスは、見当のつかない場所で失敗する。
  cd /srv/loop/project
  exec "$helper" "$BRIEF" "$LIMIT"
fi

export CODEX_HOME=/home/solver/.codex

# codex のソルバーは、自分自身の ChatGPT ログインで認証する。それはモード 700 の
# ホームの下にある。ほかのアカウントは読めず、そしてこうする狙いどおり、
# ソルバーもほかの誰のものも読めない。共有の資格情報ファイルはあえて置かない:
# `sudo -u solver -H codex login --device-auth`。
if [ ! -r "$CODEX_HOME/auth.json" ]; then
  echo "solver-run: solver is not logged in. Run:" >&2
  echo "    sudo -u solver -H codex login --device-auth" >&2
  echo "Logging in as any other account does NOT work: /home/<other> is 0700." >&2
  exit 3
fi

# エージェントを起動する前に作業ツリーへ移る。下の `--cd` は codex にどの
# ディレクトリをワークスペースとみなすかを伝えるが、プロセス自身の cwd は
# 変えない。cwd は sudo が呼び出し元から渡し、呼び出し元はホームが 0700 の
# ランナーだ。ソルバーはそこをたどることすらできず、サンドボックスが準備の途中で
# 失敗し、エラーを `src/` に対して報告する。本当の原因から遠い。
cd /srv/loop/project

# --ignore-user-config  認証には CODEX_HOME を使うが、config.toml は読まない。
#                       これでブリーフがソルバーの唯一の入力になる
#                       （RUNNER_SPEC 5 章）。無いとエージェントは周りの設定を
#                       拾い、「1ステップ分の情報」が事実ではなく主張になる。
# --ignore-rules        ユーザーとプロジェクトの .rules ファイルについても同じ。
# --ephemeral           セッションのファイルをディスクに残さないので、ソルバーは
#                       前のステップを再開できない。BOOTSTRAP はステップ間で
#                       ソルバーが記憶を失うことを求めている。これはその要求を
#                       約束ではなく仕組みにしたもの。
# --sandbox workspace-write
#                       codex 自身のサンドボックスで、2つ目の柵。要になるのは
#                       ファイルシステムのほう（RUNNER_SPEC 1-2）で、src/ は
#                       グループで書け、plan/ と .runner/ は 700 runner だ。2つが
#                       食い違えばファイルシステムが勝つ。ソルバーが言葉で
#                       すり抜けられない柵だからだ。
#
# 上限時間はランナーではなくここで掛ける。先頭の LIMIT を参照。
exec timeout --kill-after=30 "$LIMIT" codex exec \
  --cd /srv/loop/project \
  --sandbox workspace-write \
  --skip-git-repo-check \
  --ignore-user-config \
  --ignore-rules \
  --ephemeral \
  --color never \
  - < "$BRIEF"
