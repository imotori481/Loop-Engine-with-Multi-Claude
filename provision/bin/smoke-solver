#!/usr/bin/env bash
# 最初の実験。ランナーはそもそもソルバーを動かせるか。
#
#     sudo -u runner /srv/loop/bin/smoke-solver
#
# これが通るまで、その先は何も意味を持たない。だから、あえて最小の往復にする。
# runner がブリーフを書き、solver を別の uid で起動し、solver が src/ に
# ファイルを1つ書く。
#
# 確かめること（順に）:
#   1. sudoers の Runas の例外が効き、起動スクリプトに届く
#   2. エージェントが人のログインではなく /etc/loop/solver.env で認証する
#   3. エージェントが端末なしで最後まで動く
#   4. できたファイルが solver の所有である。つまり、書いたのは本当に solver で、
#      runner ではない
set -euo pipefail

[ "$(id -un)" = "runner" ] || { echo "run as runner: sudo -u runner $0" >&2; exit 1; }

BRIEF=/srv/loop/brief/smoke.md
TARGET=/srv/loop/project/src/smoke.txt
MARKER="loop-smoke-ok"

rm -f "$TARGET"

cat > "$BRIEF" <<EOF
Create the file src/smoke.txt with exactly this single line of content:

$MARKER

Do nothing else. Do not create other files. Do not modify existing files.
EOF

echo "--- invoking solver ---"
rc=0
sudo -u solver /srv/loop/bin/solver-run "$BRIEF" || rc=$?
echo "--- solver exited rc=$rc ---"

fail=0
note() { echo "  $1"; }
bad()  { echo "  FAIL: $1"; fail=1; }

if [ ! -f "$TARGET" ]; then
  bad "src/smoke.txt was not created"
else
  owner="$(stat -c '%U' "$TARGET")"
  if [ "$owner" = "solver" ]; then
    note "ok: src/smoke.txt owned by solver"
  else
    bad "src/smoke.txt owned by $owner, expected solver"
  fi
  if grep -Fqx "$MARKER" "$TARGET"; then
    note "ok: content matches"
  else
    bad "content does not contain the expected line (got: $(head -c 120 "$TARGET"))"
  fi
fi

# solver は、計画から締め出されたままでなければならない。solver として試すの
# ではなく、モードを見て確かめる。sudoers の例外は solver-run だけを名指しして
# いるので、ここで `sudo -u solver test ...` は拒否され、どちらの結果も何も
# 証明しない。
planmode="$(stat -c '%U:%G %a' /srv/loop/project/plan)"
if [ "$planmode" = "runner:runner 700" ]; then
  note "ok: plan/ still runner:runner 700"
else
  bad "plan/ is '$planmode', expected 'runner:runner 700'"
fi

rm -f "$TARGET" "$BRIEF"

echo
if [ "$fail" -eq 0 ]; then
  echo "smoke-solver: PASS"
else
  echo "smoke-solver: FAIL"
  exit 1
fi
